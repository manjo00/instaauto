# Copy this file to `secrets.properties` (which is git-ignored) and fill in real values.
# The build reads these into BuildConfig. Steps to obtain them: docs/SETUP_GUIDE.md (Phase 4).

# --- Meta / Instagram (Business Login for Instagram) ---
# NOTE: use the Instagram App ID/Secret from
#   App Dashboard > Instagram > API setup with Instagram login > Business login settings
# NOT the general App ID/Secret on Settings > Basic. They are different values.
META_APP_ID=
META_APP_SECRET=
META_GRAPH_VERSION=v21.0

# --- Cloudinary (media hosting, unsigned upload preset) ---
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_UPLOAD_PRESET=

# --- OAuth redirect ---
# Registered in the Meta App Dashboard under Instagram > API setup with Instagram login
# > Business login settings > OAuth redirect URIs. It never has to resolve to a real
# server: the app opens Instagram's login in a WebView and intercepts the redirect to
# read the authorization code out of the URL.
OAUTH_REDIRECT_URI=https://autoinsta.local/oauth
