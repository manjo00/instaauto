<?xml version="1.0" encoding="utf-8"?>
<!--
  Android 12+ (dataExtractionRules). Same reasoning as backup_rules.xml: an encrypted
  file whose Keystore key cannot travel with it is worse than no file at all.

  device-transfer matters most here — that is Samsung Smart Switch, the likeliest way
  this app ever moves phones.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="sharedpref" path="autoinsta_secure_prefs.xml" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="sharedpref" path="autoinsta_secure_prefs.xml" />
    </device-transfer>
</data-extraction-rules>
